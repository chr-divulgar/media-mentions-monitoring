# Variables requeridas por apps/web-ui

# Base URL del API (Axios)
VITE_API_LOCAL=http://localhost:3001

# Puerto para Vite dev/preview (ver vite.config.ts)
VITE_PORT=4200
# Firebase Configuration (get these from Firebase Console)
# Nota: Estos valores se incluyen en la app del cliente (no son secretos)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id