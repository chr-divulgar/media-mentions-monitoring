<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <AssemblyName>MediaOpsCore.Workers.Operations.Worker</AssemblyName>
    <RootNamespace>MediaOpsCore.Workers.Operations</RootNamespace>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="8.1.0" />

    <ProjectReference Include="..\..\Modules\Capture\Capture.Application\Capture.Application.csproj" />
    <ProjectReference Include="..\..\Modules\ProcessGuardian\ProcessGuardian.Application\ProcessGuardian.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Segmentation\Segmentation.Application\Segmentation.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Application\MediaOpsCore.BuildingBlocks.Application\MediaOpsCore.BuildingBlocks.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native\win-x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
