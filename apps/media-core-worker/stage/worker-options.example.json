{
  "segmentationIntervalSeconds": 30,
  "discreteWorkerIntervalSeconds": 1800,
  "captureSourcesFilePath": "stage/capture-sources.json",
  "pluginProfilesFilePath": "stage/plugin-profiles.json",
  "continuousMediaAllowList": "radio,television",
  "captureMaxDegreeOfParallelism": 64,
  "enableCanaryMode": false,
  "canaryPlatformPercent": 100,
  "canaryPlatformMinPercent": 10,
  "canaryPlatformMaxPercent": 100,
  "canaryPlatformAllowList": null,
  "stageFilesystemRootPath": "stage-evidence",
  "audioOutputRootPath": "D:\\",
  "defaultFlacWindowDurationSeconds": 12,
  "defaultOpusFlushIntervalSeconds": 30,
  "defaultOpusRotationIntervalHours": 1,
  "defaultOpusBitrateKbps": 64,
  "enableDecoderReconnect": true,
  "decoderReconnectDelayMaxSeconds": 5,
  "rtspPreferTcp": true,
  "enableFlacSilenceChunking": true,
  "flacSilenceMinChunkSeconds": 8,
  "flacSilenceMaxChunkSeconds": 14,
  "flacSilenceHoldMilliseconds": 250,
  "flacSilenceAnalysisWindowMilliseconds": 20,
  "flacSilenceAdaptiveThresholdMultiplier": 1.7,
  "flacSilenceNoiseFloorEmaAlpha": 0.08,
  "flacSilenceHighPassCutoffHz": 120,
  "ytdlpBinDirectory": "bin",
  "ytdlpResolutionTimeoutSeconds": 60,
  "youtubeCookiesFilePath": "../../shared-cookies/youtube-cookies.txt",
  "youtubeCookiesAlertFilePath": "../../shared-cookies/youtube-auth-required.flag",
  "webNewsEnabled": false,
  "webNewsKeywordsPerQuery": 8,
  "webNewsMaxConcurrency": 4,
  "webNewsRequestTimeoutSeconds": 20,
  "webNewsMaxFailedAttempts": 3,
  "dailyHeadlinesEnabled": false,
  "dailyHeadlinesTime": "07:00",

  "firebaseDatabase": {
    "baseUrl": "https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com",
    "platformsPath": "platforms",
    "authToken": "YOUR_FIREBASE_DATABASE_SECRET_OR_AUTH_TOKEN",
    "requestTimeoutSeconds": 15
  }
}

