[
  {
    "pluginId": "radio-default",
    "media": "radio",
    "platform": null,
    "ingestionMode": "continuous",
    "toolExecutable": "ffmpeg",
    "toolArgumentsTemplate": "-i {url} -t 30 -f segment out_%03d.mp3",
    "commandTimeoutSeconds": 30
  },
  {
    "pluginId": "video-default",
    "media": "video",
    "platform": null,
    "ingestionMode": "continuous",
    "toolExecutable": "ffmpeg",
    "toolArgumentsTemplate": "-i {url} -t 30 -f segment out_%03d.mp4",
    "commandTimeoutSeconds": 30
  },
  {
    "pluginId": "youtube-video",
    "media": "video",
    "platform": "youtube",
    "ingestionMode": "continuous",
    "toolExecutable": "yt-dlp",
    "toolArgumentsTemplate": "{url}",
    "commandTimeoutSeconds": 45
  },
  {
    "pluginId": "web-scraper-default",
    "media": "internet",
    "platform": null,
    "ingestionMode": "discrete",
    "toolExecutable": "python",
    "toolArgumentsTemplate": "-m scraper.run --url {url}",
    "commandTimeoutSeconds": 120
  },
  {
    "pluginId": "pdf-ingestion-default",
    "media": "document",
    "platform": null,
    "ingestionMode": "discrete",
    "toolExecutable": "python",
    "toolArgumentsTemplate": "-m pdf_ingest.run --source {url}",
    "commandTimeoutSeconds": 120
  }
]
