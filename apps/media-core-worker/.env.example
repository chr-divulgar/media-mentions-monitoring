# Copy to .env and set the real values. Do not commit .env to version control.

# Google Speech Recognition API key (required for audio transcription)
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# Firebase Realtime Database configuration (optional)
# Set these to enable Firebase as primary capture source store.
# Leave unset to fall back to stage/capture-sources.json.
FIREBASE_BASE_URL=https://your-project.firebaseio.com
FIREBASE_AUTH_TOKEN=your-firebase-auth-token
FIREBASE_PLATFORMS_PATH=platforms
FIREBASE_REQUEST_TIMEOUT_SECONDS=15
