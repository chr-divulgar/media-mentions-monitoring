# Copy to .env and set the real values. Do not commit .env to version control.

# Google Speech Recognition API key (required for audio transcription)
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# The configuration (capture sources, clients, users' backup copy) lives in the local MongoDB
# `config` database, edited from the web-api's settings screens. The worker needs no Firebase
# credentials. Override the connection string here (default: mongodb://localhost:27017).
# MONGODB_URI=mongodb://localhost:27017

# Public https address of the archive FTP folder; enables the PDF copy of web notes (RQ-014)
ARCHIVE_PUBLIC_BASE_URL=

# SerpApi key: Google's News tab for the main keyword of each client (see SerpApiNewsProvider).
# Needs "serpApiEnabled": true in stage/worker-options.json. The free plan has 250 searches a month.
SERPAPI_API_KEY=
